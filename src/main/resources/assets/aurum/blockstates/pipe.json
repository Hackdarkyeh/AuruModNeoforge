{
  "multipart": [
    { "apply": { "model": "aurum:block/pipe_core" } },
    { "when": { "up": "true" },    "apply": { "model": "aurum:block/pipe_arm" } },
    { "when": { "down": "true" },  "apply": { "model": "aurum:block/pipe_arm", "x": 180 } },
    { "when": { "north": "true" }, "apply": { "model": "aurum:block/pipe_arm", "x": 90 } },
    { "when": { "south": "true" }, "apply": { "model": "aurum:block/pipe_arm", "x": 90, "y": 180 } },
    { "when": { "east": "true" },  "apply": { "model": "aurum:block/pipe_arm", "x": 90, "y": 90 } },
    { "when": { "west": "true" },  "apply": { "model": "aurum:block/pipe_arm", "x": 90, "y": 270 } }
  ]
}